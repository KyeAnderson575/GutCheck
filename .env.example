# Firebase web app config — copy this file to .env.local and fill in real values.
# Real values come from: Firebase Console -> Project Settings -> Your apps -> Web app config.
# .env.local is gitignored. Never commit real values to this file.
#
# CI uses GitHub Actions secrets with the same names; see .github/workflows/deploy.yml.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000000000
